<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Daybook – To-Do List</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✅</text></svg>">
<style>
:root{
  --bg:#f3f5f2;--surface:#ffffff;--text:#1d2a26;--muted:#66736e;--line:#dde3df;
  --accent:#1f6f5c;--accent-text:#ffffff;--danger:#b3372e;
  --high:#c4452f;--med:#c98a12;--low:#3b7f5c;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#121a17;--surface:#1b2622;--text:#e6eee9;--muted:#98a8a1;--line:#2c3a35;
    --accent:#4fb99b;--accent-text:#0d1512;--danger:#ef7b70;--high:#ef7b66;--med:#e6b04a;--low:#6fc597;
  }
}
:root[data-theme="dark"]{
  --bg:#121a17;--surface:#1b2622;--text:#e6eee9;--muted:#98a8a1;--line:#2c3a35;
  --accent:#4fb99b;--accent-text:#0d1512;--danger:#ef7b70;--high:#ef7b66;--med:#e6b04a;--low:#6fc597;
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;line-height:1.45}
.wrap{max-width:760px;margin:0 auto;padding:24px 16px 48px}
header{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:20px}
h1{font-size:1.9rem;margin:0;letter-spacing:-.02em}
.sub{color:var(--muted);margin:2px 0 0;font-size:.95rem}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.icon-btn{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:8px 12px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
.stat b{display:block;font-size:1.6rem;line-height:1.1}
.stat span{color:var(--muted);font-size:.85rem}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:16px}
.form{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.form .title{grid-column:1/-1}
label{display:flex;flex-direction:column;gap:4px;font-size:.8rem;color:var(--muted)}
input,select{background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:9px 11px;width:100%}
.form .actions{grid-column:1/-1;display:flex;gap:8px;align-items:center}
.primary{background:var(--accent);color:var(--accent-text);border:0;border-radius:9px;padding:10px 18px;font-weight:600}
.ghost{background:transparent;border:1px solid var(--line);border-radius:9px;padding:10px 14px}
.error{color:var(--danger);font-size:.85rem;min-height:1.2em;margin:0}
.filters{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:10px}
ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
li.task{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:start;background:var(--surface);border:1px solid var(--line);border-left:5px solid var(--med);border-radius:12px;padding:12px 14px}
li.task.p-high{border-left-color:var(--high)}li.task.p-medium{border-left-color:var(--med)}li.task.p-low{border-left-color:var(--low)}
li.task input[type=checkbox]{width:20px;height:20px;margin-top:3px;accent-color:var(--accent)}
.t-title{font-weight:600;word-break:break-word}
.done .t-title{text-decoration:line-through;color:var(--muted)}
.meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;font-size:.78rem;color:var(--muted)}
.chip{border:1px solid var(--line);border-radius:999px;padding:2px 9px}
.chip.overdue{color:var(--danger);border-color:var(--danger)}
.row-actions{display:flex;gap:6px}
.row-actions button{background:transparent;border:1px solid var(--line);border-radius:8px;padding:5px 10px;font-size:.85rem}
.row-actions .del{color:var(--danger)}
.empty{text-align:center;color:var(--muted);padding:28px 8px}
@media (max-width:640px){
  .form{grid-template-columns:1fr 1fr}
  .filters{grid-template-columns:1fr 1fr}.filters label:first-child{grid-column:1/-1}
  li.task{grid-template-columns:auto 1fr}.row-actions{grid-column:2}
}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1>Daybook</h1>
      <p class="sub">Plan your day and tick things off.</p>
    </div>
    <button class="icon-btn" id="themeBtn" aria-label="Toggle dark mode">🌙 Dark</button>
  </header>

  <section class="stats" aria-label="Task totals">
    <div class="stat"><b id="sTotal">0</b><span>Total</span></div>
    <div class="stat"><b id="sPending">0</b><span>Pending</span></div>
    <div class="stat"><b id="sDone">0</b><span>Completed</span></div>
  </section>

  <section class="panel">
    <form class="form" id="taskForm" novalidate>
      <label class="title">Task
        <input id="title" maxlength="120" placeholder="What needs doing?" autocomplete="off">
      </label>
      <label>Category
        <select id="category">
          <option>Personal</option><option>Work</option><option>Study</option><option>Health</option><option>Other</option>
        </select>
      </label>
      <label>Priority
        <select id="priority">
          <option value="high">High</option><option value="medium" selected>Medium</option><option value="low">Low</option>
        </select>
      </label>
      <label>Due date
        <input type="date" id="due">
      </label>
      <div></div>
      <div class="actions">
        <button class="primary" id="saveBtn" type="submit">Add task</button>
        <button class="ghost" id="cancelBtn" type="button" hidden>Cancel edit</button>
        <p class="error" id="err" role="alert"></p>
      </div>
    </form>
  </section>

  <section class="panel filters" aria-label="Search and filters">
    <label>Search
      <input id="q" type="search" placeholder="Search tasks">
    </label>
    <label>Status
      <select id="fStatus"><option value="all">All</option><option value="pending">Pending</option><option value="completed">Completed</option></select>
    </label>
    <label>Category
      <select id="fCat"><option value="all">All</option><option>Personal</option><option>Work</option><option>Study</option><option>Health</option><option>Other</option></select>
    </label>
    <label>Priority
      <select id="fPri"><option value="all">All</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select>
    </label>
  </section>

  <ul id="list"></ul>
</div>

<script>
(function(){
  var KEY="daybook.tasks.v1", THEME="daybook.theme";
  var tasks=[], editingId=null;
  var $=function(id){return document.getElementById(id)};

  function load(){
    try{var raw=localStorage.getItem(KEY);tasks=raw?JSON.parse(raw):[];if(!Array.isArray(tasks))tasks=[]}catch(e){tasks=[]}
  }
  function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks))}catch(e){}}

  function applyTheme(t){
    if(t==="dark"||t==="light")document.documentElement.setAttribute("data-theme",t);
    var dark=document.documentElement.getAttribute("data-theme")==="dark"||
      (!document.documentElement.getAttribute("data-theme")&&matchMedia("(prefers-color-scheme: dark)").matches);
    $("themeBtn").textContent=dark?"☀️ Light":"🌙 Dark";
  }
  function initTheme(){
    var t=null;try{t=localStorage.getItem(THEME)}catch(e){}
    applyTheme(t);
  }
  $("themeBtn").addEventListener("click",function(){
    var cur=document.documentElement.getAttribute("data-theme")||(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light");
    var next=cur==="dark"?"light":"dark";
    try{localStorage.setItem(THEME,next)}catch(e){}
    applyTheme(next);
  });

  function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
  function today(){var d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")}
  function fmt(d){var p=d.split("-");return new Date(+p[0],+p[1]-1,+p[2]).toLocaleDateString(undefined,{day:"numeric",month:"short",year:"numeric"})}

  function render(){
    var done=tasks.filter(function(t){return t.done}).length;
    $("sTotal").textContent=tasks.length;$("sDone").textContent=done;$("sPending").textContent=tasks.length-done;

    var q=$("q").value.trim().toLowerCase(),fs=$("fStatus").value,fc=$("fCat").value,fp=$("fPri").value;
    var rank={high:0,medium:1,low:2};
    var shown=tasks.filter(function(t){
      if(q&&t.title.toLowerCase().indexOf(q)<0&&t.category.toLowerCase().indexOf(q)<0)return false;
      if(fs==="pending"&&t.done)return false;
      if(fs==="completed"&&!t.done)return false;
      if(fc!=="all"&&t.category!==fc)return false;
      if(fp!=="all"&&t.priority!==fp)return false;
      return true;
    }).sort(function(a,b){
      if(a.done!==b.done)return a.done?1:-1;
      if(rank[a.priority]!==rank[b.priority])return rank[a.priority]-rank[b.priority];
      return (a.due||"9999").localeCompare(b.due||"9999");
    });

    var list=$("list");
    if(!shown.length){
      list.innerHTML='<li class="empty">'+(tasks.length?"No tasks match your search or filters.":"No tasks yet. Add your first task above.")+'</li>';
      return;
    }
    var td=today();
    list.innerHTML=shown.map(function(t){
      var overdue=t.due&&!t.done&&t.due<td;
      return '<li class="task p-'+t.priority+(t.done?' done':'')+'" data-id="'+t.id+'">'+
        '<input type="checkbox" '+(t.done?'checked':'')+' aria-label="Mark \''+esc(t.title)+'\' as '+(t.done?'pending':'completed')+'">'+
        '<div><div class="t-title">'+esc(t.title)+'</div><div class="meta">'+
          '<span class="chip">'+esc(t.category)+'</span>'+
          '<span class="chip">'+t.priority.charAt(0).toUpperCase()+t.priority.slice(1)+' priority</span>'+
          (t.due?'<span class="chip'+(overdue?' overdue':'')+'">'+(overdue?'Overdue: ':'Due ')+fmt(t.due)+'</span>':'')+
        '</div></div>'+
        '<div class="row-actions"><button class="edit">Edit</button><button class="del">Delete</button></div></li>';
    }).join("");
  }

  function resetForm(){
    editingId=null;$("taskForm").reset();$("err").textContent="";
    $("saveBtn").textContent="Add task";$("cancelBtn").hidden=true;
  }

  $("taskForm").addEventListener("submit",function(e){
    e.preventDefault();
    var title=$("title").value.trim();
    if(!title){$("err").textContent="Enter a task name before saving.";$("title").focus();return}
    if(title.length<3){$("err").textContent="Task name must be at least 3 characters.";$("title").focus();return}
    var dup=tasks.some(function(t){return t.id!==editingId&&t.title.toLowerCase()===title.toLowerCase()&&!t.done});
    if(dup){$("err").textContent="A pending task with this name already exists.";return}
    var data={title:title,category:$("category").value,priority:$("priority").value,due:$("due").value};
    if(editingId){
      tasks=tasks.map(function(t){return t.id===editingId?Object.assign({},t,data):t});
    }else{
      tasks.unshift(Object.assign({id:Date.now().toString(36)+Math.random().toString(36).slice(2,6),done:false},data));
    }
    save();resetForm();render();
  });
  $("cancelBtn").addEventListener("click",resetForm);

  $("list").addEventListener("click",function(e){
    var li=e.target.closest("li.task");if(!li)return;
    var id=li.getAttribute("data-id");
    if(e.target.classList.contains("del")){
      if(confirm("Delete this task?")){tasks=tasks.filter(function(t){return t.id!==id});if(editingId===id)resetForm();save();render()}
    }else if(e.target.classList.contains("edit")){
      var t=tasks.filter(function(x){return x.id===id})[0];if(!t)return;
      editingId=id;$("title").value=t.title;$("category").value=t.category;$("priority").value=t.priority;$("due").value=t.due||"";
      $("saveBtn").textContent="Save changes";$("cancelBtn").hidden=false;$("err").textContent="";
      $("title").focus();window.scrollTo({top:0,behavior:"smooth"});
    }else if(e.target.type==="checkbox"){
      tasks=tasks.map(function(x){return x.id===id?Object.assign({},x,{done:e.target.checked}):x});
      save();render();
    }
  });

  ["q","fStatus","fCat","fPri"].forEach(function(id){$(id).addEventListener("input",render)});

  load();initTheme();render();
})();
</script>
</body>
</html>
